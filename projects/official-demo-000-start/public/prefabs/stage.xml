<Scene format="hero-scene" version="1">
  <Entity id="stage" name="舞台">
    <Transform/>
    <Entity id="title" name="立體標題">
      <Transform position="0 2.9 -7"/>
      <Text3D
        text="HERO ENGINE"
        size="0.55"
        color="#ffd75e"
        emissive="0.35"
        castShadow="true"
        depth="0.12"
        bevel="true"
        bevelSize="0.012"
        bevelThickness="0.02"
      />
    </Entity>
    <Entity id="camera" name="攝影機">
      <Transform position="7 3 0" rotation="-90 66.801409 90"/>
      <Camera fov="55"/>
    </Entity>
    <Entity id="sky-light" name="天空光">
      <Transform position="0 1 0"/>
      <Light kind="hemisphere" color="#bcd4ff" intensity="1.2" groundColor="#30281f"/>
    </Entity>
    <Entity id="sun" name="太陽">
      <Transform position="4 8 3" rotation="-69.443955 25.087329 48.509307"/>
      <Light intensity="2.5" castShadow="true" shadowArea="16"/>
    </Entity>
    <Entity id="ground" name="地板">
      <Transform position="0 -1.2 0" rotation="-90 0 0"/>
      <MeshRenderer receiveShadow="true">
        <geometry plane="20"/>
        <material>
          <standard map="textures/checker.png" repeat="10" color="#8d97a8" roughness="0.85"/>
        </material>
      </MeshRenderer>
    </Entity>
    <Entity id="flag" name="旗幟（波浪著色器）">
      <Transform position="0 1.8 -7"/>
      <MeshRenderer castShadow="true">
        <geometry plane="4 1.6 48 20"/>
        <material>
          <standard color="#c8463c" roughness="0.7" side="double"/>
        </material>
      </MeshRenderer>
    </Entity>
    <Entity id="walls" name="地板與牆（碰撞體）">
      <Transform/>
      <Entity id="floor" name="地板碰撞">
        <Transform position="0 -1.3 0"/>
        <Collider halfExtents="10 0.1 10"/>
      </Entity>
      <Entity id="wall-east" name="東牆">
        <Transform position="10.1 1 0"/>
        <Collider halfExtents="0.1 3 10"/>
      </Entity>
      <Entity id="wall-west" name="西牆">
        <Transform position="-10.1 1 0"/>
        <Collider halfExtents="0.1 3 10"/>
      </Entity>
      <Entity id="wall-south" name="南牆">
        <Transform position="0 1 10.1"/>
        <Collider halfExtents="10 3 0.1"/>
      </Entity>
      <Entity id="wall-north" name="北牆">
        <Transform position="0 1 -10.1"/>
        <Collider halfExtents="10 3 0.1"/>
      </Entity>
    </Entity>
  </Entity>
</Scene>
